// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  nisn          String?
  class         String?
  rollNumber    String?
  role          Role              @default(STUDENT)
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sessions      Session[]
  accounts      Account[]
  responses     StudentResponse[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// STRUKTUR MODUL, FASE & BUILDER LAYOUT
// ==========================================

model Module {
  id          String   @id @default(cuid())
  code        String   @unique // Misal: "MODUL-01"
  title       String   // Misal: "CIDOMO - DINAMIKA GERAK"
  description String?  @db.Text
  order       Int      @default(1)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenes      Scene[]

  @@map("module")
}

model Scene {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  code        String   // Misal: "FASE_1", "FASE_2"
  title       String   // Misal: "ORIENTASI & PREDIKSI"
  order       Int      @default(1)
  status      String   @default("TERKUNCI") // "TERBUKA" | "TERKUNCI"

  // Konfigurasi layout bawaan (opsional)
  layoutConfig Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks         Block[]
  builderContent BuilderContent? // Relasi 1-to-1 dengan JSON tree struktur builder @dnd-kit

  @@index([moduleId])
  @@map("scene")
}

// Model khusus penyimpan JSON Tree hasil drag-and-drop dari GridBuilder
model BuilderContent {
  id        String   @id @default(cuid())
  sceneId   String   @unique
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  // Menyimpan seluruh array `BuilderItem[]` (AccessCard, Sub-AccessCard, beserta komponen-komponennya)
  content   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("builder_content")
}

model Block {
  id        String   @id @default(cuid())
  sceneId   String
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  type      String   // "TEXT_MEDIA", "FLIP_CARD", "QUIZ", "SIMULATION", "TELEMETRY_TABLE"
  title     String?  // Judul Widget

  content   Json?

  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  @@index([sceneId])
  @@map("block")
}

// ==========================================
// STRUKTUR SOAL & RISET (TERSTRUKTUR)
// ==========================================

model Question {
  id                  String            @id @default(cuid())
  blockId             String
  block               Block             @relation(fields: [blockId], references: [id], onDelete: Cascade)

  code                String            // Kode unik riset, misal: "PREDIKSI_01"
  type                QuestionType      @default(MULTIPLE_CHOICE)
  prompt              String            @db.Text // Teks pertanyaan utama

  hasConfidenceSlider Boolean           @default(true) // Slider keyakinan (CRI)
  hasReasonInput      Boolean           @default(true) // Kolom "ALASAN AWAL"

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  options             QuestionOption[]
  responses           StudentResponse[]

  @@index([blockId])
  @@map("question")
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  code        String   // "A", "B", "C", "D"
  label       String   // Misal: "2,5 m/s"
  description String?  @db.Text
  isCorrect   Boolean  @default(false)

  responses   StudentResponse[]

  @@index([questionId])
  @@map("question_option")
}

// ==========================================
// DATA JAWABAN SISWA (TUTUP BUKU / RISET)
// ==========================================

model StudentResponse {
  id               String          @id @default(cuid())

  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  reasonAnswer     String?         @db.Text // Teks "ALASAN AWAL"
  essayAnswer      String?         @db.Text // Teks isian murni

  confidenceLevel  Int?            // Nilai CRI (0 - 100 %)

  submittedAt      DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("student_response")
}
